# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=studylab_audiobook

# SQLite Fallback / Local Testing (used when DB_HOST is empty or in test mode)
DB_USE_SQLITE=false
SQLITE_PATH=.studylab/studylab.db

# Speech Synthesis Engine
TTS_PROVIDER=edge-tts
TTS_DEFAULT_VOICE=en-US-ChristopherNeural

# Optional Paid Providers (Only needed if TTS_PROVIDER=openai)
OPENAI_API_KEY=

# Network Telemetry Ping Probing Targets
LAN_PING_HOST=192.168.1.1
TAILSCALE_PING_HOST=100.100.100.100

# Audio Cache Configuration
# Folders for cover images, saved quote audio and the background-sound library (created on first use).
# COVER_DIR=.studylab/covers
# QUOTES_DIR=.studylab/quotes
# AMBIENT_DIR=.studylab/ambient
AUDIO_CACHE_DIR=.studylab/cache/audio

# Voice cloning samples and exported audio
VOICE_SAMPLES_DIR=.studylab/voice_samples
EXPORT_DIR=.studylab/exports

# Desktop app
API_BASE_URL=http://127.0.0.1:5000

# HeyGen Voice (only needed if TTS_PROVIDER=heygen)
HEYGEN_API_KEY=
# heygen-voice-1 (default quality), heygen-voice-1-turbo, or heygen-voice-1-turbo-free
HEYGEN_MODEL=heygen-voice-1
# Language sent with every request, and mp3 (5x smaller) or wav audio
HEYGEN_LANGUAGE=vi
HEYGEN_AUDIO_FORMAT=mp3
# Voice id used when none is chosen (a voice of your own workspace). Empty = first voice found.
HEYGEN_DEFAULT_VOICE=
# HeyGen allows 30 requests/minute per workspace member; keep a little below it.
HEYGEN_REQUESTS_PER_MINUTE=28

# Mock provider (TTS_PROVIDER=mock): simulate a slow / flaky service to test the player offline
MOCK_TTS_LATENCY_SECONDS=0
# Latency varies by +/- this many seconds
MOCK_TTS_JITTER_SECONDS=0
MOCK_TTS_ERROR_RATE=0
# Optional: a number makes the failures reproducible
MOCK_TTS_SEED=

# --- Accounts -------------------------------------------------------------
# The administrator is created on the first start. If ADMIN_PASSWORD is empty a random password is
# generated and written ONCE to the backend log (docker logs studylab-backend).
# Change it later with: docker exec -it studylab-backend python -m src.core.auth.admin_cli reset-password admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Signs the login tokens. Empty = a random secret is created and kept in the database.
JWT_SECRET=
JWT_EXPIRE_HOURS=12
# Cloned voices an ordinary user may keep (the HeyGen account and its daily clone allowance are shared).
MAX_VOICES_PER_USER=3
# DEVELOPMENT ONLY. true = the sign-in page shows 3 one-click boxes (admin, khanhhoa36, xuanhai18) WITH their
# passwords, and those accounts are created at start. Never enable on a server other people can reach.
DEV_QUICK_LOGIN=false
# Passwords of the demo accounts (only used when DEV_QUICK_LOGIN=true). Leave empty for a fake default.
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_KHANHHOA36=
DEMO_PASSWORD_XUANHAI18=
