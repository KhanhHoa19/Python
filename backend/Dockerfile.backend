FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg

# System dependencies for pygame/matplotlib/ping probing
RUN apt-get update && apt-get install -y --no-install-recommends \
    iputils-ping \
    libsdl2-2.0-0 \
    libsdl2-mixer-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Install Python dependencies + cryptography (required by PyMySQL for MySQL 8 caching_sha2_password)
RUN pip install --no-cache-dir -r requirements.txt cryptography

COPY src/ ./src/
COPY pyproject.toml .

RUN mkdir -p /app/.studylab/cache/audio

EXPOSE 5000

CMD ["sh", "-c", "python -m src.core.storage.migrations && uvicorn src.api.app:app --host 0.0.0.0 --port 5000"]
